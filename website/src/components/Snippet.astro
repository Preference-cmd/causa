---
// Shows Rust code from tests/consumers/site-guides; see src/lib/snippet.ts.
import { Code } from '@astrojs/starlight/components';
import { snippet } from '../lib/snippet';

interface Props {
  /** Path inside tests/consumers/site-guides, e.g. `src/bin/context_editing.rs`. */
  file: string;
  anchor?: string;
  title?: string;
}

const { file, anchor, title } = Astro.props;
---

<Code code={snippet(file, anchor)} lang="rust" title={title} />
