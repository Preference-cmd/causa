---
// Causa layering, as enforced by the CI dependency-direction guard:
// kernel <- protocol <- provider · kernel <- runtime · kernel <- extension
// (*, extension) <- causa. Arrows read as "depends on".
---
<div class="landing not-content mx-auto my-8 max-w-2xl font-mono text-sm">
  <div class="space-y-2 text-center">
    <div class="rounded-xl border px-4 py-3">
      <strong>causa</strong>
      <span class="opacity-70"> — facade · depended on by none</span>
    </div>
    <div class="opacity-50" aria-hidden="true">▼ depends on ▼</div>
    <div class="grid gap-2 sm:grid-cols-3">
      <div class="rounded-xl border px-4 py-3">
        <strong>provider</strong>
        <br />
        <span class="opacity-70">reqwest ModelGateway adapters</span>
      </div>
      <div class="rounded-xl border px-4 py-3">
        <strong>runtime</strong>
        <br />
        <span class="opacity-70">reference driver</span>
      </div>
      <div class="rounded-xl border px-4 py-3">
        <strong>extension</strong>
        <br />
        <span class="opacity-70">MCP tool sources</span>
      </div>
    </div>
    <div class="opacity-50" aria-hidden="true">▼</div>
    <div class="rounded-xl border px-4 py-3">
      <strong>protocol</strong>
      <span class="opacity-70"> — pure wire translation (no transport, no driver)</span>
    </div>
    <div class="opacity-50" aria-hidden="true">▼</div>
    <div class="rounded-xl border px-4 py-3">
      <strong>kernel</strong>
      <span class="opacity-70"> — facts + contracts · no I/O, no transport, no policy</span>
    </div>
  </div>
  <p class="mt-3 text-center font-sans text-sm opacity-70">
    Machine-enforced by a CI guard on every push — never by review.
  </p>
</div>
